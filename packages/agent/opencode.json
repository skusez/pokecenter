{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "digest": {
      "description": "Restates an email under fixed headings. Text only, no tools.",
      "mode": "primary",
      "system": "You restate email. You have no tools. Answer only with the JSON object requested.",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" }
      ]
    },
    "investigate": {
      "description": "Diagnoses a reported defect in the repo and opens a draft PR.",
      "mode": "primary",
      "system": "You diagnose defects reported by the people who use this software. Never merge, never push to main, never deploy.",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "allow" },
        { "action": "external_directory", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*.env", "effect": "deny" },
        { "action": "read", "resource": "*.env.*", "effect": "deny" },
        { "action": "shell", "resource": "git push*origin main*", "effect": "deny" },
        { "action": "shell", "resource": "git push*origin master*", "effect": "deny" },
        { "action": "shell", "resource": "gh pr merge*", "effect": "deny" },
        { "action": "shell", "resource": "gh release*", "effect": "deny" },
        { "action": "shell", "resource": "gh secret*", "effect": "deny" },
        { "action": "shell", "resource": "alchemy*", "effect": "deny" },
        { "action": "shell", "resource": "*deploy*", "effect": "deny" },
        { "action": "shell", "resource": "rm -rf*", "effect": "deny" },
        { "action": "shell", "resource": "curl*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "websearch", "resource": "*", "effect": "deny" }
      ]
    }
  }
}
