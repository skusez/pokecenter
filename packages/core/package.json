{
  "name": "@skusez/pokecenter",
  "version": "0.1.0",
  "description": "Turns an email inbox into triaged notifications and agent-drafted fixes: the shared core (schemas, mail parsing, triage, API definition).",
  "license": "MIT",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/skusez/pokecenter.git", "directory": "packages/core" },
  "sideEffects": false,
  "exports": {
    ".": { "types": "./dist/index.d.ts", "bun": "./src/index.ts", "default": "./dist/index.js" },
    "./*": { "types": "./dist/*.d.ts", "bun": "./src/*.ts", "default": "./dist/*.js" }
  },
  "files": ["dist", "src"],
  "scripts": { "build": "tsc -b" },
  "dependencies": { "postal-mime": "^3.0.0" },
  "peerDependencies": { "effect": "^4.0.1" },
  "devDependencies": { "effect": "catalog:" }
}
