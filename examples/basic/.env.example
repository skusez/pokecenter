# Cloudflare: an API token that can edit Workers, D1, R2, Secrets Store, Email
# Routing and DNS on the account, and the account id.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Telegram: a bot from @BotFather, and the chat its cards go to.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# The agent: printed by `bun run deploy` as `url` and `agentToken`.
POKECENTER_URL=
POKECENTER_TOKEN=

# name=path for each repo a category names; the first is where mail of
# unknown category is investigated.
REPOS=acme-web=/path/to/acme-web,acme-api=/path/to/acme-api

# opencode models as provider/model#variant; the variant is the reasoning effort.
DIGEST_MODEL=
INVESTIGATE_MODEL=
